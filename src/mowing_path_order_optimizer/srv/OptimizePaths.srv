# Cost modes. EUCLIDEAN is cheap, PLANNER asks the MBF GetPath action for each checked candidate,
# HYBRID preselects candidates by euclidean distance and asks MBF only for those candidates.
uint8 COST_EUCLIDEAN=0
uint8 COST_PLANNER=1
uint8 COST_HYBRID=2

# Processing modes.
# 1 = slicer_order: original slicer order, no POO reordering.
# 2 = ordered_fills_plus_ordered_obstacles: area outlines, ordered fills, ordered obstacles.
# 3 = ordered_obstacles_plus_ordered_fills: area outlines, ordered obstacles, ordered fills.
# 4 = mixed_fills_and_obstacles: area outlines, fills and obstacles ordered together.
uint8 PROCESSING_MODE_SLICER_ORDER=1
uint8 PROCESSING_MODE_ORDERED_FILLS_PLUS_ORDERED_OBSTACLES=2
uint8 PROCESSING_MODE_ORDERED_OBSTACLES_PLUS_ORDERED_FILLS=3
uint8 PROCESSING_MODE_MIXED_FILLS_AND_OBSTACLES=4

uint8 OUTLINE_ENTRY_MODE_SLICER_ENTRY=0
uint8 OUTLINE_ENTRY_MODE_NEAREST_OUTER_OUTLINE_ENTRY=1

slic3r_coverage_planner/Path[] paths
# Optional identity channel: same length/order as paths. If empty, optimizer uses 0..n-1.
int32[] path_indices
geometry_msgs/PoseStamped current_pose
bool enabled
uint8 processing_mode
# Outline entry modes.
# 0 = slicer_entry: use the original slicer start point for the outer area outline.
# 1 = approach_inner_outline_entry: rotate all closed area outlines to the first intersection between the approach path and the inner area outline.
uint8 outline_entry_mode
bool allow_reverse
uint8 cost_mode
uint32 max_fill_paths
uint32 candidate_limit
float64 planner_timeout
bool fallback_to_euclidean
bool fallback_to_slicer_order
bool fail_open
string planner_action
string planner_name
---
slic3r_coverage_planner/Path[] paths
# Identity/direction of each response path relative to the request.
int32[] path_indices
bool[] path_reversed
# Number of source poses the execution path was rotated by. 0 means no rotation.
uint32[] rotation_offsets
# Human readable transformations applied to the execution path, e.g. reversed, rotated_approach_inner_outline_entry.
string[] transform_flags
bool success
bool used_optimization
bool used_fallback
string message
